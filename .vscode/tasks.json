{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Move Flutter APK DEV",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "fvm flutter build apk --dart-define=ENV=DEV && cp build/app/outputs/flutter-apk/app-release.apk ./app-release.apk"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Builds the APK and moves it to project root"
    },
    {
      "label": "Build and Move Flutter APK RELEASE",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "fvm flutter build apk --release --dart-define=ENV=PROD && cp build/app/outputs/flutter-apk/app-release.apk ./app-release.apk"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Builds the APK and moves it to project root"
    },
    {
      "label": "Build IOS Runner.xcarchive",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "fvm flutter build ipa --release --no-codesign --dart-define=ENV=PROD && open -a Xcode build/ios/archive/Runner.xcarchive"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Builds Runner.xcarchive and opens it in Xcode"
    },
    {
      "label": "Dart Build_Runner",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "dart run build_runner build --delete-conflicting-outputs"
      ],
      "detail": "dart run build_runner build --delete-conflicting-outputs"
    }
  ]
}